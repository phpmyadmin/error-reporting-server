https://reports.phpmyadmin.net {
	# The document root is the webroot directory: the application code, the
	# configuration and the logs have to stay out of it.
	root * /home/reports/error-reporting-server/webroot/

	php_fastcgi unix//var/run/php8.4-fpm-reports.sock

	# Enable the static file server.
	encode gzip
	file_server

	try_files {path} {path}/ /index.php?{query}
}
